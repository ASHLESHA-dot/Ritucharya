# MongoDB connection string
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/ritucharya

# For MongoDB Atlas (Cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ritucharya?retryWrites=true&w=majority

# JWT Secret key for authentication (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here_change_this

# Server port
PORT=5000

# OpenWeather API
WEATHER_API_KEY=your_openweather_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
